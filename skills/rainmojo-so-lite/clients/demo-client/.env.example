# WordPress content and media publishing
WP_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=
WP_REST_MODE=auto
WP_WRITE_INTERVAL_SECONDS=25
WP_REQUEST_TIMEOUT_SECONDS=45

# Shopify
SHOPIFY_STORE=
SHOPIFY_TOKEN=
